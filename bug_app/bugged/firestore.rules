rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Categories: Authenticated read; authenticated write for initial seeding
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Products: Authenticated read; authenticated write for initial seeding
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Users: Owner read and write only
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Cart subcollection: Owner read and write only
      match /cart/{productId} {
        allow read, write: if isOwner(userId);
      }

      // Addresses subcollection: Owner read and write only
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Orders: Owner read, authenticated user write own order
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
