<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar & Telemetry Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POCKETQA AI"
                    android:textColor="@color/accent_cyan"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autonomous On-Device Mobile QA"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_accessibility_status"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_button_secondary"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Accessibility Settings"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Status Badges Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_gpu_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_indigo"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="LITERTLM GPU READY"
                android:textColor="@color/accent_indigo"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_badge_emerald"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="AIRPLANE MODE / OFFLINE"
                android:textColor="@color/accent_emerald"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Navigation Tabs Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tab_scanner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_tab_active"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Scanner"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tab_monitor"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Live Monitor"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tab_diagnosis"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Diagnosis &amp; Patches"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tab_analytics"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_tab_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Analytics Suite"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Dynamic Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic Views are rendered here programmatically with structured styling -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>
